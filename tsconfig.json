{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"]
  },
  "include": ["src/**/*.js"],
  "exclude": ["src/vendor"]
}
